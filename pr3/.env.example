# ── LLM Configuration ────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# ── Generation Parameters ────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Resilience ───────────────────────────────────────────────
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
